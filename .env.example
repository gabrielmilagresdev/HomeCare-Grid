# Apenas configuracao publica. Nunca coloque chaves privadas em EXPO_PUBLIC_*.
EXPO_PUBLIC_DATA_MODE=demo
# Reservados para a futura integracao, ainda nao consumidos pelo scaffold:
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# O comando npm run concierge:dev preenche estes valores em .env.local (ignorado pelo Git).
# O token é de sessão local; nunca use uma chave xAI em EXPO_PUBLIC_*.
EXPO_PUBLIC_CONCIERGE_API_URL=
EXPO_PUBLIC_CONCIERGE_CLIENT_TOKEN=
