{
  "expo": {
    "name": "Tato",
    "slug": "tato",
    "version": "0.1.0",
    "scheme": "tato",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F7F4",
    "platforms": ["android", "ios"],
    "icon": "./assets/brand/tato-icon.png",
    "android": { "adaptiveIcon": { "foregroundImage": "./assets/brand/tato-icon-foreground.png", "backgroundColor": "#29232C" } },
    "plugins": ["expo-router", ["expo-audio", { "microphonePermission": "Permita que o Tato grave sua voz para conversar com a TatinhIA." }]]
  }
