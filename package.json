{
  "name": "homecare-grid",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/domain.test.mjs tests/tooling.test.mjs",
    "test:ui": "jest --runInBand",
    "doctor": "expo-doctor",
    "bundle": "expo export --platform android --platform ios --output-dir dist",
    "check:secrets": "node scripts/check-secrets.mjs",
    "backlog:render": "node scripts/render-backlog.mjs",
    "backlog:plan": "node scripts/github-sync.mjs",
    "check:foundation": "node scripts/check-foundation.mjs"
  },
  "dependencies": {
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-expo": "58.0.4",
    "expo-doctor": "1.21.5",
    "jest": "30.0.5",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "react-dom": "19.3.0"
  }
}
